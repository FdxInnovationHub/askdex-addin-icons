<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>9ab51ea5-38f6-4d70-9140-2b6275ea73aa</Id>
  <Version>1.3.0.3</Version>
  <ProviderName>Findex Innovation Hub</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="AskDex"/>
  <Description DefaultValue="AI-powered email assistant with drafting, summarization, feedback, and more."/>
  <IconUrl DefaultValue="https://fdxinnovationhub.github.io/askdex-addin-icons/outlook/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://fdxinnovationhub.github.io/askdex-addin-icons/outlook/icon-128.png"/>
  <SupportUrl DefaultValue="https://findexgrp.sharepoint.com/:u:/s/DigitalDepartment/IQAX1tbmk6apT4z1k7-J9IOrAUNzxSOPpbl_YIpc8oP0tPg?e=PIfXWQ"/>
  <AppDomains>
    <AppDomain>https://outlook.askdex.findex.solutions</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://outlook.askdex.findex.solutions/taskpane.html?v=1.0.0.1"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.13">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgComposeGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="msgComposeDraftButton">
                    <Label resid="DraftButton.Label"/>
                    <Supertip>
                      <Title resid="DraftButton.Label"/>
                      <Description resid="DraftButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgReadGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="msgReadDraftButton">
                    <Label resid="DraftButton.Label"/>
                    <Supertip>
                      <Title resid="DraftButton.Label"/>
                      <Description resid="DraftButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="msgReadInboxButton">
                    <Label resid="InboxButton.Label"/>
                    <Supertip>
                      <Title resid="InboxButton.Label"/>
                      <Description resid="InboxButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="TaskpaneInbox.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                      <SupportsNoItemContext>true</SupportsNoItemContext>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://fdxinnovationhub.github.io/askdex-addin-icons/outlook/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://fdxinnovationhub.github.io/askdex-addin-icons/outlook/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://fdxinnovationhub.github.io/askdex-addin-icons/outlook/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://outlook.askdex.findex.solutions/commands.html?v=1.0.0.1"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://outlook.askdex.findex.solutions/taskpane.html?view=message&amp;v=1.0.0.1"/>
          <bt:Url id="TaskpaneInbox.Url" DefaultValue="https://outlook.askdex.findex.solutions/taskpane.html?view=inbox&amp;v=1.0.0.1"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="AskDex"/>
          <bt:String id="TaskpaneButton.Label" DefaultValue="AskDex"/>
          <bt:String id="DraftButton.Label" DefaultValue="Compose"/>
          <bt:String id="InboxButton.Label" DefaultValue="Daily"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open AskDex AI email assistant for drafting, summarizing, and analyzing emails."/>
          <bt:String id="DraftButton.Tooltip" DefaultValue="Draft or improve a reply to the selected email, with tone control and feedback."/>
          <bt:String id="InboxButton.Tooltip" DefaultValue="Your daily brief — inbox catch-up, meeting prep, day-at-a-glance, and emails awaiting a reply."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>